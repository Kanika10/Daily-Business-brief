<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daily Intelligence Brief</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:ital@0;1&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --text-primary:#1a1a1a;
  --text-secondary:#666666;
  --text-tertiary:#999999;
  --bg-primary:#ffffff;
  --bg-secondary:#f5f5f5;
  --border-light:#e0e0e0;
  --border-dark:#cccccc;
  --accent-blue:#0066cc;
  --accent-green:#00aa44;
  --accent-amber:#ff9900;
  --accent-red:#cc3333;
  --accent-cyan:#0099cc;
}
html,body{
  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  font-size:16px;
  line-height:1.6;
  color:var(--text-primary);
  background:var(--bg-secondary);
}
.container{
  max-width:900px;
  margin:0 auto;
  background:var(--bg-primary);
  padding:48px;
  min-height:100vh;
}

/* HEADER */
.header{
  margin-bottom:48px;
  border-bottom:2px solid var(--text-primary);
  padding-bottom:24px;
  display:grid;
  grid-template-columns:1fr auto;
  gap:32px;
  align-items:flex-start;
}
.header-title h1{
  font-size:48px;
  font-weight:800;
  line-height:1.1;
  margin-bottom:8px;
  letter-spacing:-1px;
}
.header-title h1 em{
  font-family:'Merriweather',serif;
  font-style:italic;
  font-weight:400;
  color:var(--accent-blue);
}
.header-subtitle{
  font-size:14px;
  font-weight:600;
  letter-spacing:1px;
  text-transform:uppercase;
  color:var(--text-secondary);
  margin-bottom:4px;
}
.header-meta{
  text-align:right;
}
.day-count{
  font-size:64px;
  font-weight:800;
  line-height:1;
  color:var(--text-tertiary);
  margin-bottom:8px;
}
.date-display{
  font-size:13px;
  color:var(--text-secondary);
  font-weight:500;
}

/* TIMER SECTION */
.timer-section{
  background:var(--bg-secondary);
  border:1px solid var(--border-light);
  border-radius:12px;
  padding:24px;
  margin-bottom:40px;
  display:flex;
  align-items:center;
  gap:24px;
  flex-wrap:wrap;
}
.timer-display{
  font-size:48px;
  font-weight:700;
  font-family:'Inter',monospace;
  color:var(--accent-blue);
  min-width:140px;
}
.timer-label{
  font-size:12px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:0.5px;
  color:var(--text-secondary);
  margin-bottom:4px;
}
.timer-progress-bar{
  flex:1;
  min-width:200px;
  height:6px;
  background:var(--border-light);
  border-radius:3px;
  overflow:hidden;
}
.timer-progress-fill{
  height:100%;
  background:var(--accent-blue);
  width:0%;
  transition:width 0.5s linear;
}
.phase-label{
  font-size:12px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:0.5px;
  color:var(--accent-blue);
}
.timer-buttons{
  display:flex;
  gap:12px;
}
.btn{
  padding:10px 20px;
  font-size:13px;
  font-weight:600;
  border-radius:8px;
  border:none;
  cursor:pointer;
  transition:all 0.2s;
  font-family:'Inter',sans-serif;
  letter-spacing:0.5px;
}
.btn-primary{
  background:var(--text-primary);
  color:var(--bg-primary);
}
.btn-primary:hover{
  background:var(--accent-blue);
}
.btn-secondary{
  background:transparent;
  color:var(--text-primary);
  border:1px solid var(--border-dark);
}
.btn-secondary:hover{
  border-color:var(--text-primary);
  background:var(--bg-secondary);
}

/* SECTION */
.section{
  margin-bottom:48px;
}
.section-header{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:20px;
  padding-bottom:12px;
  border-bottom:2px solid var(--border-light);
}
.section-number{
  font-size:12px;
  font-weight:700;
  background:var(--text-primary);
  color:var(--bg-primary);
  padding:6px 10px;
  border-radius:6px;
  min-width:32px;
  text-align:center;
}
.section-number.blue{background:var(--accent-blue)}
.section-number.green{background:var(--accent-green)}
.section-number.amber{background:var(--accent-amber)}
.section-number.red{background:var(--accent-red)}
.section-title{
  font-size:18px;
  font-weight:700;
  letter-spacing:-0.5px;
  flex:1;
}
.section-time{
  font-size:12px;
  color:var(--text-tertiary);
  font-weight:500;
}

/* FORM ELEMENTS */
.form-group{
  margin-bottom:16px;
}
.label{
  display:block;
  font-size:12px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:0.5px;
  color:var(--text-secondary);
  margin-bottom:8px;
}
.input-box{
  background:var(--bg-secondary);
  border:1px solid var(--border-light);
  border-radius:12px;
  padding:16px;
  width:100%;
  font-family:'Inter',sans-serif;
  font-size:15px;
  color:var(--text-primary);
  line-height:1.6;
  transition:all 0.2s;
  resize:none;
  min-height:80px;
}
.input-box:focus{
  outline:none;
  border-color:var(--accent-blue);
  background:var(--bg-primary);
  box-shadow:0 0 0 3px rgba(0,102,204,0.1);
}
.input-box.small{
  min-height:40px;
}
.input-box::placeholder{
  color:var(--text-tertiary);
}

/* SIGNAL HEADLINE */
.signal-headline{
  background:var(--text-primary);
  border-radius:12px;
  padding:24px;
  margin-bottom:16px;
}
.signal-headline .label{
  color:rgba(255,255,255,0.6);
}
.signal-headline .input-box{
  background:transparent;
  border:none;
  color:#ffffff;
  font-size:22px;
  font-weight:700;
  padding:0;
  min-height:auto;
}
.signal-headline .input-box::placeholder{
  color:rgba(255,255,255,0.3);
}

/* LENSES GRID */
.lens-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
  margin-bottom:16px;
}
.lens-card{
  background:var(--bg-secondary);
  border:2px solid var(--border-light);
  border-radius:12px;
  padding:20px;
  border-left:4px solid var(--border-dark);
}
.lens-card.tech{border-left-color:var(--accent-cyan)}
.lens-card.behavior{border-left-color:#9933cc}
.lens-card.bizmodel{border-left-color:var(--accent-amber)}
.lens-card.capital{border-left-color:var(--accent-green)}
.lens-card.india{border-left-color:var(--accent-red)}
.lens-card .input-box{
  background:var(--bg-primary);
  border:1px solid var(--border-light);
  font-size:14px;
  min-height:100px;
}

/* OUTPUT CARDS */
.output-grid{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:16px;
  margin-bottom:16px;
}
.output-card{
  border-radius:12px;
  padding:20px;
  border:1px solid var(--border-light);
}
.output-card.invest{
  background:rgba(0,170,68,0.08);
  border-color:rgba(0,170,68,0.3);
}
.output-card.invest .label{
  color:var(--accent-green);
}
.output-card.build{
  background:rgba(255,153,0,0.08);
  border-color:rgba(255,153,0,0.3);
}
.output-card.build .label{
  color:var(--accent-amber);
}
.output-card.career{
  background:rgba(0,102,204,0.08);
  border-color:rgba(0,102,204,0.3);
}
.output-card.career .label{
  color:var(--accent-blue);
}
.output-card .input-box{
  background:var(--bg-primary);
  font-size:14px;
  min-height:90px;
}

/* TAGS */
.tags-container{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:8px;
}
.tag{
  background:var(--bg-primary);
  border:1px solid var(--border-dark);
  border-radius:24px;
  padding:6px 12px;
  font-size:12px;
  font-weight:600;
  cursor:pointer;
  transition:all 0.2s;
  user-select:none;
  letter-spacing:0.3px;
}
.tag:hover{
  border-color:var(--text-primary);
  background:var(--bg-secondary);
}
.tag.active{
  background:var(--text-primary);
  color:var(--bg-primary);
  border-color:var(--text-primary);
}

/* STREAK */
.streak-section{
  border-top:2px solid var(--border-light);
  padding-top:24px;
  margin-top:40px;
}
.streak-label{
  font-size:12px;
  font-weight:700;
  text-transform:uppercase;
  color:var(--text-secondary);
  margin-bottom:12px;
}
.streak-days{
  display:flex;
  gap:4px;
  flex-wrap:wrap;
}
.streak-day{
  width:24px;
  height:24px;
  border-radius:6px;
  background:var(--border-light);
  cursor:pointer;
  transition:all 0.2s;
}
.streak-day.completed{
  background:var(--accent-green);
}
.streak-day.today{
  background:var(--accent-amber);
  box-shadow:0 0 0 2px var(--accent-amber);
  transform:scale(1.1);
}
.streak-count{
  font-size:13px;
  font-weight:700;
  color:var(--accent-green);
  margin-left:12px;
}

/* ACTIONS */
.actions-bar{
  display:flex;
  gap:12px;
  margin-top:32px;
  padding-top:24px;
  border-top:2px solid var(--border-light);
  flex-wrap:wrap;
  align-items:center;
}
.save-status{
  font-size:12px;
  color:var(--text-tertiary);
  margin-left:auto;
  font-weight:500;
}

/* PAST ENTRIES */
.past-section{
  margin-top:48px;
  display:none;
}
.past-section.show{
  display:block;
}
.past-title{
  font-size:12px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:0.5px;
  color:var(--text-secondary);
  margin-bottom:16px;
}
.past-list{
  display:flex;
  flex-direction:column;
  gap:8px;
}
.past-entry{
  background:var(--bg-secondary);
  border:1px solid var(--border-light);
  border-radius:12px;
  padding:16px;
  cursor:pointer;
  transition:all 0.2s;
  display:grid;
  grid-template-columns:auto 1fr auto;
  gap:16px;
  align-items:center;
}
.past-entry:hover{
  border-color:var(--accent-blue);
  background:var(--bg-primary);
}
.past-date{
  font-size:12px;
  font-weight:600;
  color:var(--text-secondary);
  white-space:nowrap;
}
.past-signal{
  font-size:14px;
  font-weight:600;
  color:var(--text-primary);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.past-tags{
  display:flex;
  gap:4px;
}
.past-tag{
  font-size:11px;
  background:var(--accent-blue);
  color:white;
  padding:2px 8px;
  border-radius:12px;
  font-weight:600;
}

/* DIVIDER */
.divider{
  text-align:center;
  margin:40px 0;
  position:relative;
}
.divider::before{
  content:'';
  position:absolute;
  top:50%;
  left:0;
  right:0;
  height:1px;
  background:var(--border-light);
}
.divider span{
  position:relative;
  background:var(--bg-primary);
  padding:0 16px;
  font-size:12px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:0.5px;
  color:var(--text-secondary);
}

/* RESPONSIVE */
@media(max-width:768px){
  .container{padding:24px}
  .header{grid-template-columns:1fr;gap:24px}
  .lens-grid,.output-grid{grid-template-columns:1fr}
  .header-title h1{font-size:32px}
  .day-count{font-size:48px}
  .timer-section{flex-direction:column;align-items:flex-start}
}
</style>
</head>
<body>
<div class="container">

  <!-- HEADER -->
  <header class="header">
    <div class="header-title">
      <div class="header-subtitle">Daily Intelligence Brief</div>
      <h1>Signal &amp; <em>Strategy</em></h1>
    </div>
    <div class="header-meta">
      <div class="day-count" id="dayCount">001</div>
      <div class="date-display" id="dateDisplay">May 10, 2026</div>
    </div>
  </header>

  <!-- TIMER -->
  <div class="timer-section">
    <div>
      <div class="timer-label">Session Timer</div>
      <div class="timer-display" id="timerDisplay">30:00</div>
    </div>
    <div class="timer-progress-bar">
      <div class="timer-progress-fill" id="timerFill"></div>
    </div>
    <div class="phase-label" id="phaseLabel">Ready</div>
    <div class="timer-buttons">
      <button class="btn btn-primary" id="startBtn" onclick="startTimer()">Start</button>
      <button class="btn btn-secondary" onclick="resetTimer()">Reset</button>
    </div>
  </div>

  <!-- SECTION 1: SIGNAL -->
  <div class="section">
    <div class="section-header">
      <span class="section-number">01</span>
      <span class="section-title">Today's Signal</span>
      <span class="section-time">5 min</span>
    </div>

    <div class="signal-headline">
      <label class="label">The one thing that moved today</label>
      <textarea class="input-box" id="signal" placeholder="What's the most important business event today?" oninput="autoResize(this)"></textarea>
    </div>

    <div class="form-group">
      <label class="label">Source &amp; Category</label>
      <textarea class="input-box small" id="source" placeholder="TechCrunch, Reuters, etc." oninput="autoResize(this)"></textarea>
      <div class="tags-container" id="categoryTags">
        <span class="tag" onclick="toggleTag(this)">AI</span>
        <span class="tag" onclick="toggleTag(this)">Funding</span>
        <span class="tag" onclick="toggleTag(this)">Policy</span>
        <span class="tag" onclick="toggleTag(this)">Earnings</span>
        <span class="tag" onclick="toggleTag(this)">Startup</span>
        <span class="tag" onclick="toggleTag(this)">M&A</span>
        <span class="tag" onclick="toggleTag(this)">Consumer</span>
        <span class="tag" onclick="toggleTag(this)">India</span>
      </div>
    </div>
  </div>

  <div class="divider"><span>Five Lens Analysis • 10 min</span></div>

  <!-- SECTION 2: LENSES -->
  <div class="section">
    <div class="section-header">
      <span class="section-number amber">02</span>
      <span class="section-title">Run the Five Lenses</span>
      <span class="section-time">2 min each</span>
    </div>

    <div class="lens-grid">
      <div class="lens-card tech">
        <label class="label">⬡ Technology Shift</label>
        <textarea class="input-box" placeholder="What new capability is this creating?" oninput="autoResize(this)"></textarea>
      </div>
      <div class="lens-card behavior">
        <label class="label">◈ Behavior Shift</label>
        <textarea class="input-box" placeholder="How are humans changing?" oninput="autoResize(this)"></textarea>
      </div>
      <div class="lens-card bizmodel">
        <label class="label">◇ Business Model</label>
        <textarea class="input-box" placeholder="Who wins? Who loses?" oninput="autoResize(this)"></textarea>
      </div>
      <div class="lens-card capital">
        <label class="label">▲ Capital Flow</label>
        <textarea class="input-box" placeholder="Where does money go?" oninput="autoResize(this)"></textarea>
      </div>
    </div>

    <div class="lens-card india" style="margin-bottom:0">
      <label class="label">◉ India Angle</label>
      <textarea class="input-box" placeholder="What does this look like in India in 2-3 years?" oninput="autoResize(this)"></textarea>
    </div>
  </div>

  <div class="divider"><span>Connect the Dots • 10 min</span></div>

  <!-- SECTION 3: CONNECT -->
  <div class="section">
    <div class="section-header">
      <span class="section-number green">03</span>
      <span class="section-title">Connect to Patterns</span>
      <span class="section-time">patterns compound</span>
    </div>

    <div class="form-group">
      <label class="label">What does this remind you of?</label>
      <textarea class="input-box" placeholder="Link to past signals or known patterns..." oninput="autoResize(this)"></textarea>
    </div>

    <div class="form-group">
      <label class="label">Emerging Pattern</label>
      <textarea class="input-box" placeholder="What trend is building?" oninput="autoResize(this)"></textarea>
    </div>

    <div class="form-group">
      <label class="label">Pattern Tags</label>
      <div class="tags-container" id="patternTags">
        <span class="tag" onclick="toggleTag(this)">AI wave</span>
        <span class="tag" onclick="toggleTag(this)">Platform consolidation</span>
        <span class="tag" onclick="toggleTag(this)">Job market shift</span>
        <span class="tag" onclick="toggleTag(this)">Capital rotation</span>
        <span class="tag" onclick="toggleTag(this)">Regulation</span>
        <span class="tag" onclick="toggleTag(this)">Commoditization</span>
      </div>
    </div>
  </div>

  <div class="divider"><span>Position Outputs • 5 min</span></div>

  <!-- SECTION 4: POSITION -->
  <div class="section">
    <div class="section-header">
      <span class="section-number blue">04</span>
      <span class="section-title">My Position</span>
      <span class="section-time">what's your bet?</span>
    </div>

    <div class="output-grid">
      <div class="output-card invest">
        <label class="label">If Investing</label>
        <textarea class="input-box" placeholder="I'd watch..." oninput="autoResize(this)"></textarea>
      </div>
      <div class="output-card build">
        <label class="label">If Building</label>
        <textarea class="input-box" placeholder="I'd explore..." oninput="autoResize(this)"></textarea>
      </div>
      <div class="output-card career">
        <label class="label">For Career</label>
        <textarea class="input-box" placeholder="This signals..." oninput="autoResize(this)"></textarea>
      </div>
    </div>

    <div class="form-group">
      <label class="label">My Prediction (6-18 months)</label>
      <textarea class="input-box" id="prediction" placeholder="Because of this signal, I expect..." oninput="autoResize(this)"></textarea>
    </div>

    <div class="form-group">
      <label class="label">Confidence &amp; Uncertainty</label>
      <textarea class="input-box" placeholder="I'm less sure about... / I'd need to know..." oninput="autoResize(this)"></textarea>
    </div>
  </div>

  <!-- STREAK -->
  <div class="streak-section">
    <div class="streak-label">30-day streak</div>
    <div style="display:flex;align-items:center">
      <div class="streak-days" id="streakDays"></div>
      <span class="streak-count" id="streakCount">0 days</span>
    </div>
  </div>

  <!-- ACTIONS -->
  <div class="actions-bar">
    <button class="btn btn-primary" onclick="saveEntry()">Save Brief</button>
    <button class="btn btn-secondary" onclick="exportTxt()">Export</button>
    <button class="btn btn-secondary" onclick="clearForm()">Clear</button>
    <span class="save-status" id="saveStatus">Unsaved</span>
  </div>

  <!-- PAST ENTRIES -->
  <div class="past-section" id="pastSection">
    <div class="past-title">Previous Briefs</div>
    <div class="past-list" id="pastList"></div>
  </div>

</div>

<script>
const STORAGE_KEY = 'signal_strategy_briefs';

function getToday(){
  return new Date().toISOString().split('T')[0];
}

function formatDate(iso){
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
}

function autoResize(el){
  el.style.height='auto';
  el.style.height=Math.min(el.scrollHeight,400)+'px';
}

function toggleTag(el){
  el.classList.toggle('active');
}

function getActiveTags(containerId){
  return [...document.getElementById(containerId).querySelectorAll('.tag.active')].map(t=>t.textContent);
}

function getAllTextareas(){
  const data={};
  document.querySelectorAll('textarea').forEach((a,i)=>{
    data['area_'+i]=a.value;
  });
  return data;
}

function setAllTextareas(data){
  document.querySelectorAll('textarea').forEach((a,i)=>{
    if(data['area_'+i]){
      a.value=data['area_'+i];
      autoResize(a);
    }
  });
}

function loadBriefs(){
  try{return JSON.parse(localStorage.getItem(STORAGE_KEY))||[];}catch(e){return [];}
}

function saveBriefs(briefs){
  localStorage.setItem(STORAGE_KEY,JSON.stringify(briefs));
}

function saveEntry(){
  const briefs=loadBriefs();
  const today=getToday();
  const entry={
    date:today,
    signal:document.getElementById('signal').value,
    source:document.getElementById('source').value,
    categories:getActiveTags('categoryTags'),
    patterns:getActiveTags('patternTags'),
    prediction:document.getElementById('prediction').value,
    textareas:getAllTextareas(),
    savedAt:new Date().toISOString()
  };
  const idx=briefs.findIndex(b=>b.date===today);
  if(idx>=0)briefs[idx]=entry;
  else briefs.unshift(entry);
  saveBriefs(briefs);
  const time=new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
  document.getElementById('saveStatus').textContent='Saved '+time;
  updateStreak();
  renderPast();
}

function clearForm(){
  if(!confirm('Clear today\'s form?'))return;
  document.querySelectorAll('textarea').forEach(a=>{a.value='';autoResize(a);});
  document.querySelectorAll('.tag.active').forEach(t=>t.classList.remove('active'));
  document.getElementById('saveStatus').textContent='Cleared';
}

function exportTxt(){
  const today=getToday();
  const areas=document.querySelectorAll('textarea');
  let out=`SIGNAL & STRATEGY BRIEF\n${formatDate(today)}\n${'─'.repeat(50)}\n\n`;
  out+=`SIGNAL: ${document.getElementById('signal').value}\n`;
  out+=`SOURCE: ${document.getElementById('source').value}\n\n`;
  out+=`FIVE LENSES:\n`;
  ['Technology','Behavior','Business Model','Capital Flow'].forEach((label,i)=>{
    out+=`\n${label}:\n${areas[i+2]?areas[i+2].value:''}\n`;
  });
  out+=`\nINDIA ANGLE:\n${areas[6]?areas[6].value:''}\n`;
  out+=`\nPREDICTION:\n${document.getElementById('prediction').value}\n`;
  
  const blob=new Blob([out],{type:'text/plain'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=`brief-${today}.txt`;
  a.click();
}

function updateStreak(){
  const briefs=loadBriefs();
  let streak=0;
  const d=new Date();
  for(let i=0;i<30;i++){
    const iso=d.toISOString().split('T')[0];
    if(briefs.find(b=>b.date===iso))streak++;
    else if(i>0)break;
    d.setDate(d.getDate()-1);
  }
  document.getElementById('streakCount').textContent=streak+(streak===1?' day':' days');

  const streakDays=document.getElementById('streakDays');
  streakDays.innerHTML='';
  const today=getToday();
  const ref=new Date();
  for(let i=29;i>=0;i--){
    const d2=new Date();d2.setDate(ref.getDate()-i);
    const iso=d2.toISOString().split('T')[0];
    const el=document.createElement('div');
    el.className='streak-day';
    if(iso===today)el.classList.add('today');
    else if(briefs.find(b=>b.date===iso))el.classList.add('completed');
    el.title=formatDate(iso);
    streakDays.appendChild(el);
  }

  document.getElementById('dayCount').textContent=String(briefs.length).padStart(3,'0');
}

function renderPast(){
  const briefs=loadBriefs();
  const section=document.getElementById('pastSection');
  const list=document.getElementById('pastList');
  if(briefs.length===0){section.classList.remove('show');return;}
  section.classList.add('show');
  list.innerHTML='';
  briefs.slice(0,7).forEach(b=>{
    const el=document.createElement('div');
    el.className='past-entry';
    el.innerHTML=`
      <div class="past-date">${formatDate(b.date)}</div>
      <div class="past-signal">${b.signal||'(no signal)'}</div>
      <div class="past-tags">${(b.categories||[]).slice(0,3).map(t=>`<span class="past-tag">${t}</span>`).join('')}</div>
    `;
    el.onclick=()=>loadEntry(b);
    list.appendChild(el);
  });
}

function loadEntry(entry){
  if(!confirm('Load this entry?'))return;
  document.querySelectorAll('.tag.active').forEach(t=>t.classList.remove('active'));
  if(entry.textareas)setAllTextareas(entry.textareas);
  (entry.categories||[]).forEach(cat=>{
    document.querySelectorAll('#categoryTags .tag').forEach(t=>{
      if(t.textContent===cat)t.classList.add('active');
    });
  });
  (entry.patterns||[]).forEach(pat=>{
    document.querySelectorAll('#patternTags .tag').forEach(t=>{
      if(t.textContent===pat)t.classList.add('active');
    });
  });
  document.getElementById('saveStatus').textContent='Viewing '+formatDate(entry.date);
}

let timerSeconds=1800;
let timerRunning=false;
let timerInterval=null;
const phases=[
  {at:1800,label:'Scan source'},
  {at:1500,label:'Five lenses'},
  {at:900,label:'Connect patterns'},
  {at:300,label:'Position'},
  {at:0,label:'Done!'}
];

function getPhase(s){
  for(let p of phases)if(s<=p.at)return p.label;
  return 'Ready';
}

function updateTimerUI(){
  const m=Math.floor(timerSeconds/60);
  const s=timerSeconds%60;
  document.getElementById('timerDisplay').textContent=
    String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
  const pct=(1800-timerSeconds)/1800*100;
  document.getElementById('timerFill').style.width=Math.min(100,pct)+'%';
  document.getElementById('phaseLabel').textContent=getPhase(timerSeconds);
}

function startTimer(){
  if(timerRunning)return;
  timerRunning=true;
  document.getElementById('startBtn').textContent='Running...';
  document.getElementById('startBtn').disabled=true;
  timerInterval=setInterval(()=>{
    if(timerSeconds<=0){
      clearInterval(timerInterval);
      timerRunning=false;
      document.getElementById('phaseLabel').textContent='Complete!';
      document.getElementById('startBtn').textContent='Done';
      return;
    }
    timerSeconds--;
    updateTimerUI();
  },1000);
}

function resetTimer(){
  clearInterval(timerInterval);
  timerRunning=false;
  timerSeconds=1800;
  updateTimerUI();
  document.getElementById('phaseLabel').textContent='Ready';
  document.getElementById('startBtn').textContent='Start';
  document.getElementById('startBtn').disabled=false;
}

// INIT
document.getElementById('dateDisplay').textContent=formatDate(getToday());
updateTimerUI();
updateStreak();
renderPast();
</script>
</body>
